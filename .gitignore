# Build artifacts — Linux and Windows MUST use separate target dirs.
# See CLAUDE.md: CARGO_TARGET_DIR=target/linux (Linux) / target/windows (Windows).
/target
/**/target
target/

# WDK / driver packaging output
*.sys
*.pdb
*.cat
*.cer
/**/package/

# Editor / OS cruft
*.swp
*~
.DS_Store
.vscode/
.idea/
System\ Volume\ Information

# Local environment overrides
.env
*.local.toml

# Windows share junk
$RECYCLE.BIN/

# Research-only checkouts (reference material, not part of the build)
/dx-samples-research-only/
/dxvk-research-only/
/dxvk/
/virtio-research-only-3d/
/vkd3d-proton/
/windows-driver-docs-research-only/
/D3D11_3_FunctionalSpec.htm

# Session scratch + external tool config
/tmp/
/.codex/
/opencode.json

# Stray compiled probe objects
*.obj
/tools/*.so

# Local clean-tree comparison mirror
/umd_clean/
__pycache__/

# umd12's host cross-check build (cargo check --target x86_64-pc-windows-msvc on
# the Linux host, PARALLEL.md §7). The CACHED bindings under
# umd12/bindgen/cached/ are deliberately COMMITTED and must not be ignored.
/umd12/target/
/umd_common/target/
